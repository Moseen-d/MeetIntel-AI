# Backend Environment Configuration
# API keys are stored securely in backend/.env (ignored in git)

# 1. Tavily Search API Key (https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-api-key

# 2. Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key
# Alternative key name supported by Google GenAI SDK:
# GOOGLE_API_KEY=your-gemini-api-key

# Gemini model to use for research analysis & briefing synthesis
GEMINI_MODEL=gemini-1.5-flash

# Backend server host & port
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
